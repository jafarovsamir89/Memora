{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memora.invalid/contracts/agent/v1/confirmation-proof.schema.json",
  "title": "Application-managed confirmation record — P0 design only",
  "type": "object", "additionalProperties": false,
  "required": ["id", "scopeId", "actorId", "actionDigest", "targetVersions", "permissionVersion", "issuedAt", "expiresAt", "state"],
  "properties": {
    "id": {"$ref": "#/$defs/uuid"}, "scopeId": {"$ref": "#/$defs/uuid"}, "actorId": {"$ref": "#/$defs/uuid"},
    "actionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetVersions": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/$defs/uuid"}, "version": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}}}},
    "permissionVersion": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["ACTIVE", "CONSUMED", "REVOKED"]}
  },
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}
}
