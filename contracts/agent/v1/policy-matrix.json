  "forbiddenAutomaticExternalEffects": [
    "send_message",
    "external_payment",
    "publish",
    "invite",
    "arbitrary_export",
    "permanent_purge"
  ],
  "globalConditions": {
    "directUserRequestRequiredForMutation": true,
    "mustCheckScopeAtReadAndCommit": true,
    "mustCheckSourceAndTargetVersions": true,
    "mustRecordEvidenceAndHistory": true,
    "undoRequiredForAutomaticChanges": true,
    "massEditRequiresPreviewAboveExistingObjectCount": 20,
    "confirmationExpiresAfterSeconds": 600,
    "preparedIsNeverCommitted": true,
    "confirmationsMustBindExactDigestAndVersions": true,
    "planInheritsStrictestEmbeddedPolicy": true
  }
