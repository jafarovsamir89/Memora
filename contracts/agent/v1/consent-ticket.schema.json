{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memora.invalid/contracts/agent/v1/consent-ticket.schema.json",
  "title": "Future-agent transmission preflight — not an authorization token",
  "type": "object", "additionalProperties": false,
  "required": ["scopeId", "provider", "kind", "payloadDigest", "sessionGeneration", "policyVersion", "records"],
  "properties": {
    "scopeId": {"$ref": "#/$defs/uuid"}, "provider": {"const": "GEMINI"}, "kind": {"enum": ["CURRENT_TURN", "MEMORY_EXCERPT"]},
    "payloadDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessionGeneration": {"$ref": "#/$defs/version"}, "policyVersion": {"$ref": "#/$defs/version"},
    "records": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "category", "revision"], "properties": {"id": {"$ref": "#/$defs/uuid"}, "category": {"enum": ["VOICE_OR_TEXT_TURN", "PERSISTED_MEMORY"]}, "revision": {"$ref": "#/$defs/version"}}}}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "version": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
  }
}
